{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m app.maintenance purge-expired-security-records",
    "cronSchedule": "17 3 * * *",
    "restartPolicyType": "NEVER"
  }
}
